# Configurações do Servidor Backend
PORT=8080
NODE_ENV=development
JWT_SECRET=sua_chave_secreta_super_segura_fixit_gs_2024
JWT_EXPIRATION_HOURS=24

# Banco de Dados Relacional (Oracle Cloud / PL/SQL)
ORACLE_DB_USER=rm565849
ORACLE_DB_PASSWORD=sua_senha_oracle
ORACLE_DB_CONNECTION_STRING=oracle.fiap.com.br:1521/ORCL

# Banco de Dados Não-Relacional (MongoDB Atlas / Local)
MONGODB_URI=mongodb://localhost:27017/fixit_db

# Mensageria (RabbitMQ)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_QUEUE_INCIDENTS=fixit.incidents.queue
RABBITMQ_EXCHANGE=fixit.direct.exchange

# Provedor de Nuvem & Storage (Azure Blob Storage)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=stfixitprod;AccountKey=sua_chave_azure;EndpointSuffix=core.windows.net
AZURE_CONTAINER_EVIDENCE=evidence

# Integração com Módulos de Inteligência Artificial
OPENAI_API_KEY=sua_chave_openai_ou_azure_openai
AI_SEVERITY_MODEL=gpt-4o-mini

